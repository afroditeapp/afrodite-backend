{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "ignorePaths": [
    "target/**",
    "data/**",
    "tmp_data/**",
    "config/**",
    "crates/api_client/**",
    "crates/model/src/schema.rs",
    "**/*.lock"
  ],
  "words": [
    // Project and domain terms
    "afrodite",
    "ptext",
    "bitflag",
    "bitflags",
    "nonbinaries",
    "syncable",
    "loggable",
    "ctype",
    "blocklist",
    "unban",
    "unbans",
    "Xhigh",
    "moderations",
    "Unallowed",
    "replacen",
    "mtype",
    "Disconnecter",
    "unobfuscated",
    "cooldown",

    // Libraries and tools
    "utoipa",
    "rustc",
    "thiserror",
    "chrono",
    "serde",
    "nalgebra",
    "sysinfo",
    "reqwest",
    "rustls",
    "zstd",
    "jsonwebtoken",
    "flate",
    "smallvec",
    "debuginfo",
    "libsqlite",
    "libpq",
    "openapitools",
    "crox",
    "noout",
    "signkey",
    "plpgsql",
    "BIGSERIAL",
    "Zself",
    "vergen",
    "gitcl",
    "urlencode",
    "eudi",
    "jitsi",
    "seetaface",
    "rustface",
    "hentai",
    "maxmind",
    "maxminddb",
    "geoip",
    "MMDB",
    "mozjpeg",
    "xoshiro",
    "tungstenite",
    "deadpool",
    "lettre",
    "onnx",
    "Ollama",
    "Lanczos",
    "imageops",
    "Exif",
    "Seedable",

    // Technical terms
    "starttls",
    "smtps",
    "alpn",
    "apln",
    "oneshot",
    "cpus",
    "inodes",
    "journalctl",
    "statvfs",
    "freelist",
    "kibibytes",
    "mebibytes",
    "gibibytes",
    "Insertable",
    "Bytea",
    "Datelike",
    "Timelike",
    "Deque",
    "rsplit",
